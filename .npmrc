# Deny dependency lifecycle scripts. npm 11.10+ already defaults to this and
# gates exceptions behind `npm approve-scripts`; stating it here keeps the
# policy explicit and applies to older npm too.
#
# No exception is needed for electron, whose postinstall would otherwise fetch
# its ~100MB binary: with scripts denied, `node_modules/electron/dist/` is empty
# after install, and the CLI wrapper downloads the binary lazily on first use
# instead. Verified — both gates still pass, and gate 2 reports electron 43.4.1.
ignore-scripts=true

# Wait 14 full days before resolving a newly published version, so a
# compromised release has time to be caught and unpublished. Requires npm
# 11.10 or later; older npm ignores it.
min-release-age=14
