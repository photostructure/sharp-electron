# Pinned upstream sources. `scripts/fetch-sources.sh` clones exactly these
# commits into .work/, so a build is reproducible without git submodules.
#
# To bump: change a ref, run `./scripts/build-all.sh`, and fix any patch that
# stops applying (scripts/apply-patches.sh fails loudly rather than guessing).
# Both patches touch small, stable areas, but neither is guaranteed to survive
# an arbitrary upstream bump.

SHARP_REPO=https://github.com/lovell/sharp.git
SHARP_REF=7f1a0a22cc285fe180766f4935d50b55af6e8432   # v0.35.4

SHARP_LIBVIPS_REPO=https://github.com/lovell/sharp-libvips.git
SHARP_LIBVIPS_REF=6e5971d333377743163edc3ad9e5d0b897abcbc9   # v1.3.3
